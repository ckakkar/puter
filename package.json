{
  "name": "poltergeist",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --host 127.0.0.1",
    "build": "npm run wasm && npm run check && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write web/src scripts tests *.json *.ts README.md && cargo fmt --all",
    "test:core": "cargo test --workspace --offline",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --offline --all-targets -- -D warnings",
    "test:unit": "vitest run --config vitest.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "benchmark": "npm run wasm && node scripts/benchmark.mjs",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
